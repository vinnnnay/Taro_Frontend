# The deployed API's base URL, with no trailing slash.
# Local:      http://localhost:4000
# Production: https://your-api.onrender.com
#
# NEXT_PUBLIC_ is baked into the client bundle at BUILD time, not read at
# runtime -- so changing it in Vercel requires a redeploy, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:4000
